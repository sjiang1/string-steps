# Passcode that gates the whole app (matches the cookie checked in src/proxy.ts).
APP_PASSCODE=your-passcode-here

# Upstash Redis credentials for plan/schedule/practice-log/tracks storage.
# Leave KV_REST_API_URL unset to fall back to the local data/*.json files.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Shortcut-driven video upload.
# UPLOAD_TOKEN is a long random string shared with the iOS Shortcut (generate with: openssl rand -hex 32).
# BLOB_READ_WRITE_TOKEN comes from your Vercel Blob store ("vercel_blob_rw_<storeId>_<secret>").
UPLOAD_TOKEN=generate-a-long-random-string
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx_xxx
